###########################################################################

prefix=/sdcard/Kad/install
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="HTTP HTTPS"
supported_features="AsynchDNS brotli HTTP2 HTTPS-proxy IPv6 Largefile libz SSL threadsafe zstd"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
License: curl
Copyright: Copyright (C) Daniel Stenberg, <daniel@haxx.se>, et al.
Version: 8.22.0-IMPERSONATE
Source: https://curl.se/download/curl-8.22.0-IMPERSONATE.tar.gz
Requires.private: libcares,libbrotlidec,libbrotlicommon,libzstd,libnghttp2
Libs: -L${libdir} -lcurl-impersonate
Libs.private: -L/sdcard/Kad/build -lpthread -lcares -lssl -lcrypto -lz -lbrotlidec -lbrotlicommon -lzstd -lnghttp2 -lcrypto -lz
Cflags: -I${includedir}
Cflags.private: -DCURL_STATICLIB
Link.ABI: c
