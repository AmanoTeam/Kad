+
+    int major = 0;
+    PARSE_INT(&major, 1, '1', '3');
+
+    if (major == 1) {
+        /* need ".<digit>" plus at least one more char (space or CR) = 3 chars minimum */
+        if (buf_end - buf < 3) {
